MEMORIA_URL=http://127.0.0.1:8100
MEMORIA_MASTER_KEY=replace-with-memoria-master-key
# A separate key supplied to the leaderboard, never the Memoria master key.
ADAPTER_API_KEY=replace-with-adapter-key
ADAPTER_STATE_DIR=./var
# Log every journal operation during controlled load tests. Normal operation
# logs one summary per Add plus slow operations and errors, without payloads.
ADAPTER_JOURNAL_LOG_ALL_OPERATIONS=false
ADAPTER_JOURNAL_SLOW_MS=100
MEMORIA_NAMESPACE=agent-memory-leaderboard
MEMORIA_TIMEOUT_SECONDS=120
