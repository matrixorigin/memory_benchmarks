# Optional; only used with --mode answer-eval. Never commit actual credentials.
# Answer and Judge can use different OpenAI-compatible providers.
# Current development baseline: DashScope Beijing qwen-plus for both roles.
# Local diagnostics only; these settings do not select AML's official models.
BENCHMARK_ANSWER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BENCHMARK_ANSWER_MODEL=qwen-plus
BENCHMARK_ANSWER_API_KEY=
BENCHMARK_JUDGE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BENCHMARK_JUDGE_MODEL=qwen-plus
BENCHMARK_JUDGE_API_KEY=
# Local budget accounting; this encoding is not asserted to match every model.
BENCHMARK_TOKEN_ENCODING=o200k_base
BENCHMARK_INPUT_BUDGET=117760
BENCHMARK_OUTPUT_TOKENS=1024
